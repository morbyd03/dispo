# ==========================================
# DISPO - Configuration de l'installation
# ==========================================

# Domaine (sans https:// ni slash final)
DISPO_DOMAIN=dispo.example.com

# Fuseau horaire
TZ=Europe/Paris

# ==========================================
# Securite Django
# ==========================================

# Cle secrete unique a generer avant installation
DJANGO_SECRET_KEY=

# Ne jamais activer DEBUG en production
DJANGO_DEBUG=False

# HTTPS obligatoire pour une installation publique
DJANGO_HTTPS=True

# HSTS : activer apres validation du HTTPS
DJANGO_HSTS_SECONDS=0

# ==========================================
# Configuration SMTP
# ==========================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

DEFAULT_FROM_EMAIL="Dispo <noreply@example.com>"
SERVER_EMAIL=noreply@example.com

# ==========================================
# Personnalisation de l'application
# ==========================================

DISPO_NAME="Dispo"
DISPO_CENTRE="Centre de secours"

# Logo personnalise (facultatif)
# Placer le fichier dans le repertoire branding/
# Formats acceptes : PNG, JPEG, WebP
# Laisser vide pour utiliser le logo generique
DISPO_LOGO=

# Activer uniquement derriere un reverse proxy de confiance
# qui controle les en-tetes X-Forwarded-Proto.
DJANGO_TRUST_PROXY=False


# ==========================================
# Configuration reseau avancee
# ==========================================

# Port HTTP local sur la machine hote
DISPO_PORT=8000

# Facultatif : liste des domaines autorises
# Separes par des virgules
# DJANGO_ALLOWED_HOSTS=dispo.example.com

# Facultatif : origines CSRF autorisees
# Separees par des virgules, avec le protocole
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dispo.example.com

# ==========================================
# Reverse proxy Traefik (facultatif)
# ==========================================

TRAEFIK_NETWORK=traefik
TRAEFIK_ROUTER=dispo
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
